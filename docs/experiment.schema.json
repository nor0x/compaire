{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nor0x/compaire/blob/main/docs/experiment.schema.json",
  "title": "CompAIre experiment format",
  "description": "Schema version 1.",
  "$ref": "#/$defs/Experiment",
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "description": "Who contributed the experiment.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "github": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "view": {
          "default": "table",
          "enum": [
            "gallery",
            "slider",
            "table",
            "html",
            "svg",
            "text"
          ],
          "title": "View",
          "type": "string"
        },
        "modality": {
          "default": "text",
          "enum": [
            "text",
            "image"
          ],
          "title": "Modality",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "prompt": {
          "$ref": "#/$defs/PromptSpec"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/Run"
          },
          "title": "Runs",
          "type": "array"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "id",
        "title",
        "created_at",
        "prompt"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "HtmlOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "html",
          "default": "html",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        }
      },
      "required": [
        "path"
      ],
      "title": "HtmlOutput",
      "type": "object"
    },
    "ImageOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        }
      },
      "required": [
        "path"
      ],
      "title": "ImageOutput",
      "type": "object"
    },
    "Index": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "experiments": {
          "items": {
            "$ref": "#/$defs/IndexEntry"
          },
          "title": "Experiments",
          "type": "array"
        }
      },
      "required": [
        "generated_at"
      ],
      "title": "Index",
      "type": "object"
    },
    "IndexEntry": {
      "additionalProperties": false,
      "description": "The card shown on the site's landing page.\n\nDeliberately small: the list page loads only this, never the full runs.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "view": {
          "enum": [
            "gallery",
            "slider",
            "table",
            "html",
            "svg",
            "text"
          ],
          "title": "View",
          "type": "string"
        },
        "modality": {
          "enum": [
            "text",
            "image"
          ],
          "title": "Modality",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "run_count": {
          "default": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "contributors": {
          "default": 1,
          "title": "Contributors",
          "type": "integer"
        },
        "thumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumb"
        },
        "total_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost"
        }
      },
      "required": [
        "id",
        "title",
        "created_at",
        "view",
        "modality"
      ],
      "title": "IndexEntry",
      "type": "object"
    },
    "PromptParams": {
      "additionalProperties": true,
      "description": "Sampling parameters, applied identically to every model in the run.",
      "properties": {
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "PromptParams",
      "type": "object"
    },
    "PromptSpec": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "params": {
          "$ref": "#/$defs/PromptParams"
        }
      },
      "required": [
        "text"
      ],
      "title": "PromptSpec",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "One model's answer to the prompt.\n\nFailures are recorded rather than dropped \u2014 a model that refuses or times\nout is part of the comparison.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "sample_index": {
          "default": 0,
          "title": "Sample Index",
          "type": "integer"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "items": {
            "discriminator": {
              "mapping": {
                "html": "#/$defs/HtmlOutput",
                "image": "#/$defs/ImageOutput",
                "svg": "#/$defs/SvgOutput",
                "text": "#/$defs/TextOutput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextOutput"
              },
              {
                "$ref": "#/$defs/ImageOutput"
              },
              {
                "$ref": "#/$defs/HtmlOutput"
              },
              {
                "$ref": "#/$defs/SvgOutput"
              }
            ]
          },
          "title": "Outputs",
          "type": "array"
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "id",
        "model"
      ],
      "title": "Run",
      "type": "object"
    },
    "SvgOutput": {
      "additionalProperties": false,
      "description": "A vector drawing: an image the site can render and source it can show.\n\nKept separate from :class:`ImageOutput` because SVG is text, cannot go\nthrough Pillow, and \u2014 unlike every other asset \u2014 is a live document when\nopened directly.",
      "properties": {
        "kind": {
          "const": "svg",
          "default": "svg",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "sanitized": {
          "default": false,
          "title": "Sanitized",
          "type": "boolean"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "title": "Removed",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "SvgOutput",
      "type": "object"
    },
    "TextOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "format": {
          "default": "markdown",
          "enum": [
            "plain",
            "markdown"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "title": "TextOutput",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": true,
      "description": "Token and cost accounting, as reported by OpenRouter.\n\nExtra keys are kept, so the provider's own nested breakdowns\n(``completion_tokens_details`` and friends) survive in the committed file\neven though only the fields below are named here.",
      "properties": {
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  }
}
